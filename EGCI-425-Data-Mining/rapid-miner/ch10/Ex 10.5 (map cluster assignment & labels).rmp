          <connect from_port="input 1" to_op="Gaussian Mixture" to_port="exa"/>
          <connect from_op="Gaussian Mixture" from_port="exa" to_port="output 1"/>
          <connect from_op="Gaussian Mixture" from_port="mod" to_port="output 2"/>
          <portSpacing port="source_input 1" spacing="0"/>
