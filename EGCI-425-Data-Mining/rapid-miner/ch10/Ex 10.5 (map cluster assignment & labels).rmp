      <connect from_op="Retrieve IrisFromWeka" from_port="output" to_op="Select Clustering" to_port="input 1"/>
      <connect from_op="Select Clustering" from_port="output 1" to_op="Map Clustering on Labels" to_port="example set"/>
      <connect from_op="Select Clustering" from_port="output 2" to_op="Map Clustering on Labels" to_port="cluster model"/>
