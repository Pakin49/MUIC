          <portSpacing port="sink_output 3" spacing="0"/>
          <description align="left" color="orange" colored="true" height="90" resized="true" width="185" x="10" y="167">Don't output outlier score to avoid confusion in Apply operator (it has to process prediction confidence score)</description>
