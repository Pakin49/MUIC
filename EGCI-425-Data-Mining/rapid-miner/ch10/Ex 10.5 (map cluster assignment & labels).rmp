      <portSpacing port="sink_result 2" spacing="0"/>
      <description align="left" color="orange" colored="true" height="50" resized="true" width="229" x="172" y="148">K must equal #class labels (3 in this case)</description>
      <description align="left" color="blue" colored="true" height="73" resized="true" width="282" x="407" y="126">Apply clustering model to the whole data set. Cluster assignment is treated as predicted label &amp;amp; compared with actual label</description>
