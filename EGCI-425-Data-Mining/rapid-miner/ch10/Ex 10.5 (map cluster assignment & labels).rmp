            <parameter key="max_optimization_steps" value="100"/>
            <parameter key="use_local_random_seed" value="false"/>
            <parameter key="local_random_seed" value="1992"/>
          </operator>
          <connect from_port="input 1" to_op="K-Means Clustering" to_port="example set"/>
          <connect from_op="K-Means Clustering" from_port="cluster model" to_port="output 2"/>
          <connect from_op="K-Means Clustering" from_port="clustered set" to_port="output 1"/>
          <portSpacing port="source_input 1" spacing="0"/>
          <portSpacing port="source_input 2" spacing="0"/>
          <portSpacing port="sink_output 1" spacing="0"/>
          <portSpacing port="sink_output 2" spacing="0"/>
          <portSpacing port="sink_output 3" spacing="0"/>
          <description align="left" color="orange" colored="true" height="90" resized="true" width="126" x="10" y="123">To connect with the next operator&lt;br&gt;out1 = exa&lt;br&gt;out2 = clu</description>
        </process>
        <process expanded="true">
          <operator activated="true" class="smile:gaussian_mixture" compatibility="0.6.000" expanded="true" height="124" name="Gaussian Mixture" width="90" x="45" y="34">
            <parameter key="use_bic_optimization" value="false"/>
            <parameter key="number_of_components" value="3"/>
            <parameter key="normalize_data" value="true"/>
            <parameter key="use_diagonal" value="true"/>
